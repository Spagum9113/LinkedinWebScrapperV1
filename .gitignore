
```gitignore
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
.venv/

# Selenium cookies and raw HTML
cookies.pkl
raw.html
parsed.json

# Output files
bio.txt
profiles.db

# OS files
.DS_Store
Thumbs.db

# Logs and temp
*.log
*.tmp

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Environment variables
.env
